# Copy to your secret manager or process environment. Never commit real values.
NODE_ENV=development
# Keep evaluation until every release gate is verified. Production refuses unsafe startup.
RELEASE_MODE=evaluation
PERSISTENT_STORAGE_CONFIRMED=false
BACKUPS_CONFIRMED=false
EMAIL_DOMAIN_VERIFIED=false
PROVIDER_SMOKE_CONFIRMED=false
MONITORING_CONFIRMED=false
COMMERCIAL_BILLING_CONFIRMED=false
HOST=127.0.0.1
PORT=3000
BASE_URL=https://schedora.in
DATABASE_PATH=./data/schedora.db
TRUST_PROXY=false
# Proxies appending to X-Forwarded-For: 1 behind Render alone, 2 behind Vercel rewrite + Render
TRUST_PROXY_HOPS=1
# Serve ../frontend from this process (local dev). Render sets false; Vercel serves the frontend.
SERVE_FRONTEND=true
PRODUCT_DOMAIN=schedora.in
# Extra origins allowed to send changes, comma-separated; * matches one DNS label
ALLOWED_ORIGINS=https://schedora-eight.vercel.app/
# Share sign-in across meet./forms./flow. subdomains, e.g. .schedora.in (production only)
COOKIE_DOMAIN=.schedora.in
ANALYTICS_ENABLED=false
LOG_LEVEL=info

# Billing: open (evaluation, everything available) or enforced (verified subscriptions only)
BILLING_MODE=open
# test (signed local events) | none | <provider adapter name once chosen>
BILLING_PROVIDER=test
BILLING_WEBHOOK_SECRET=

# Email: outbox (nothing leaves the server) or http (JSON relay/provider)
EMAIL_PROVIDER=outbox
EMAIL_HTTP_URL=
EMAIL_HTTP_TOKEN=
EMAIL_FROM=Schedora <no-reply@schedora.in>

# Required before commercial release
OPERATOR_NAME=
OPERATOR_CONTACT=
OPERATOR_JURISDICTION=
DATABASE_URL=postgresql://postgres.oqvhedvblxgwfcneqcov:5UbKVjJs821xuwcK@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Requests per minute per client address
RATE_LIMIT_PER_MINUTE=600
# 32 random bytes, base64 (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
APP_ENCRYPTION_KEY=
# Simulated checkout for paid event types in production until Stripe is connected
ALLOW_TEST_PAYMENTS=false
# Public API address for provider webhooks, if different from BASE_URL
API_BASE_URL=

# SMS: outbox (nothing sent) or twilio
SMS_PROVIDER=outbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# OAuth apps (redirect URI: <BASE_URL>/api/oauth/<google|microsoft|zoom>/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# AI (Claude): recaps, chat, meeting briefs, Meet Assist drafts
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Meet Assist: inbound email webhook secret and the address people copy
INBOUND_EMAIL_SECRET=
ASSIST_ADDRESS=assist@schedora.in

{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSchedoraWebImagePull",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "AllowSchedoraWebImagePullFromRepository",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": "arn:aws:ecr:ap-south-1:255948905492:repository/schedora-web"
    },
    {
      "Sid": "AllowSchedoraWebLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:ap-south-1:255948905492:log-group:/ecs/schedora-web:log-stream:*"
    },
    {
      "Sid": "AllowSchedoraRuntimeSecretRead",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": [
        "arn:aws:secretsmanager:ap-south-1:255948905492:secret:schedora-*",
        "arn:aws:secretsmanager:ap-south-1:255948905492:secret:AppBeta-oKmh7Y"
      ]
    },
    {
      "Sid": "AllowSystemsManagerInstanceManagement",
      "Effect": "Allow",
      "Action": [
        "ssm:DescribeAssociation",
        "ssm:DescribeDocument",
        "ssm:DescribeInstanceInformation",
        "ssm:GetDeployablePatchSnapshotForInstance",
        "ssm:GetDocument",
        "ssm:GetManifest",
        "ssm:ListAssociations",
        "ssm:ListInstanceAssociations",
        "ssm:PutComplianceItems",
        "ssm:PutConfigurePackageResult",
        "ssm:PutInventory",
        "ssm:UpdateAssociationStatus",
        "ssm:UpdateInstanceAssociationStatus",
        "ssm:UpdateInstanceInformation",
        "ssmmessages:CreateControlChannel",
        "ssmmessages:CreateDataChannel",
        "ssmmessages:OpenControlChannel",
        "ssmmessages:OpenDataChannel",
        "ec2messages:AcknowledgeMessage",
        "ec2messages:DeleteMessage",
        "ec2messages:FailMessage",
        "ec2messages:GetEndpoint",
        "ec2messages:GetMessages",
        "ec2messages:SendReply"
      ],
      "Resource": "*"
    }
  ]
}

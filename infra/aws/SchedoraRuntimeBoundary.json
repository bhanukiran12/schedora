{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowSchedoraWebImagePull",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "AllowSchedoraWebImagePullFromRepository",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": "arn:aws:ecr:ap-south-1:255948905492:repository/schedora-web"
    },
    {
      "Sid": "AllowSchedoraWebLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:ap-south-1:255948905492:log-group:/ecs/schedora-web:log-stream:*"
    },
    {
      "Sid": "AllowSchedoraRuntimeSecretRead",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": [
        "arn:aws:secretsmanager:ap-south-1:255948905492:secret:schedora-*",
        "arn:aws:secretsmanager:ap-south-1:255948905492:secret:AppBeta-oKmh7Y"
      ]
    },
    {
      "Sid": "AllowSystemsManagerInstanceManagement",
      "Effect": "Allow",
      "Action": [
        "ssm:DescribeAssociation",
        "ssm:DescribeDocument",
        "ssm:DescribeInstanceInformation",
        "ssm:GetDeployablePatchSnapshotForInstance",
        "ssm:GetDocument",
        "ssm:GetManifest",
        "ssm:ListAssociations",
        "ssm:ListInstanceAssociations",
        "ssm:PutComplianceItems",
        "ssm:PutConfigurePackageResult",
        "ssm:PutInventory",
        "ssm:UpdateAssociationStatus",
        "ssm:UpdateInstanceAssociationStatus",
        "ssm:UpdateInstanceInformation",
        "ssmmessages:CreateControlChannel",
        "ssmmessages:CreateDataChannel",
        "ssmmessages:OpenControlChannel",
        "ssmmessages:OpenDataChannel",
        "ec2messages:AcknowledgeMessage",
        "ec2messages:DeleteMessage",
        "ec2messages:FailMessage",
        "ec2messages:GetEndpoint",
        "ec2messages:GetMessages",
        "ec2messages:SendReply"
      ],
      "Resource": "*"
    },
    {
      "Resource": "arn:aws:secretsmanager:ap-south-1:255948905492:secret:schedora-database-app-54D7Ve",
      "Sid": "ReadRdsApplicationCredential",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Condition": {
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::255948905492:role/schedora-web-execution"
        }
      }
    },
    {
      "Resource": "arn:aws:kms:ap-south-1:255948905492:key/5427764f-c282-4982-80d8-7d6179b6101d",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "secretsmanager.ap-south-1.amazonaws.com",
          "kms:EncryptionContext:SecretARN": "arn:aws:secretsmanager:ap-south-1:255948905492:secret:schedora-database-app-54D7Ve"
        },
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::255948905492:role/schedora-web-execution"
        }
      },
      "Sid": "DecryptRdsApplicationCredential",
      "Effect": "Allow",
      "Action": "kms:Decrypt"
    },
    {
      "Resource": "arn:aws:secretsmanager:ap-south-1:255948905492:secret:rds!db-9ff9206f-e9c2-4416-adfa-2b82ed609d6e-HHPBUH",
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "2026-11-25T18:30:00Z"
        },
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::255948905492:role/schedora-web-execution"
        }
      },
      "Sid": "TemporaryReadRdsOwnerCredential",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue"
    },
    {
      "Resource": "arn:aws:kms:ap-south-1:255948905492:key/5427764f-c282-4982-80d8-7d6179b6101d",
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "2026-11-25T18:30:00Z"
        },
        "StringEquals": {
          "kms:ViaService": "secretsmanager.ap-south-1.amazonaws.com",
          "kms:EncryptionContext:SecretARN": "arn:aws:secretsmanager:ap-south-1:255948905492:secret:rds!db-9ff9206f-e9c2-4416-adfa-2b82ed609d6e-HHPBUH"
        },
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::255948905492:role/schedora-web-execution"
        }
      },
      "Sid": "TemporaryDecryptRdsOwnerCredential",
      "Effect": "Allow",
      "Action": "kms:Decrypt"
    },
    {
      "Resource": "arn:aws:secretsmanager:ap-south-1:255948905492:secret:schedora-database-app-54D7Ve",
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "2026-11-25T18:30:00Z"
        },
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::255948905492:role/schedora-web-execution"
        }
      },
      "Sid": "TemporaryPublishRdsApplicationUrl",
      "Effect": "Allow",
      "Action": "secretsmanager:PutSecretValue"
    },
    {
      "Resource": "arn:aws:kms:ap-south-1:255948905492:key/5427764f-c282-4982-80d8-7d6179b6101d",
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "2026-11-25T18:30:00Z"
        },
        "StringEquals": {
          "kms:ViaService": "secretsmanager.ap-south-1.amazonaws.com",
          "kms:EncryptionContext:SecretARN": "arn:aws:secretsmanager:ap-south-1:255948905492:secret:schedora-database-app-54D7Ve"
        },
        "ArnEquals": {
          "aws:PrincipalArn": "arn:aws:iam::255948905492:role/schedora-web-execution"
        }
      },
      "Sid": "TemporaryEncryptRdsApplicationUrl",
      "Effect": "Allow",
      "Action": "kms:GenerateDataKey"
    }
  ]
}
